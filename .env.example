# Names of the values the Connected Apps need.
# The Android app has no .env file: type these into Settings > Connected Apps on the phone.
# They are stored encrypted on the phone and are never put in the APK or in this repo.
# Never commit a real .env.

TELEGRAM_BOT_TOKEN=            # from @BotFather, Telegram card
GOOGLE_CLIENT_ID=              # Google Cloud OAuth client (Desktop app), Gmail and Calendar cards
GOOGLE_CLIENT_SECRET=          # same client
GOOGLE_REDIRECT_URI=http://127.0.0.1   # automatic, nothing to enter (port is chosen at sign-in)
